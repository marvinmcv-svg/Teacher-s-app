# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (required) ------------------------------------------------------
# Local: run `pnpm dlx supabase start` and copy API_URL / PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key for the grading pipeline (Phase 1). Never expose to the browser.
SUPABASE_SECRET_KEY=

# Public origin used for auth redirects (magic link / Google). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# --- Inngest (background jobs) ------------------------------------------------
# Not needed locally when running the Inngest dev server.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Observability (optional in development) ----------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- AI / OCR (Phase 1 — app fails loudly without them once grading exists) ---
ANTHROPIC_API_KEY=
# Temporary alternative: NVIDIA's OpenAI-compatible API (used when AI_PROVIDER=nvidia,
# or automatically when only NVIDIA_API_KEY is set). One model serves every role.
AI_PROVIDER=
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
# Model IDs live in config, never in code (§6). Starting points; evals decide.
TINTA_MODEL_FAST=claude-haiku-5-5
TINTA_MODEL_GRADER=claude-sonnet-5-5
TINTA_MODEL_VERIFIER=claude-opus-5-5
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
# Optional
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
